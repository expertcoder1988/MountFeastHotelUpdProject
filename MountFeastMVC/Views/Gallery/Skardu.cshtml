@{
    ViewBag.Title = "Skardu Hotel Gallery | Mount Feast Hotel Skardu Pictures ";
    ViewBag.keywords = "Skardu Hotel pictures, Hotel gallery, hotel room photos, Skardu hotels, hotel room pictures, hotel picture, photos of hotel room";
    ViewBag.canonical = "https://mountfeasthotel.com/skardu-hotel-gallery";
    ViewBag.Description = "Explore Mount Feast Skardu Hotel Gallery. View high-quality hotel room photos, amenities, and our Skardu hotel pictures before booking your stay.";
}


<div class="sub-banner overview-bgi">
    <div class="overlay">
        <div class="container">
            <div class="breadcrumb-area">
                <h2 class="text-white fw-bold">
                    A Visual Journey of Luxury, Comfort, and Hospitality in Skardu
                </h2>
                Explore Mount Feast Skardu Hotel Gallery

            </div>
        </div>
    </div>
</div>

<!-- properties gallery start -->
<div class=" content-area bg-white">
    <div class="container">
        <div class="main-title-2">

            <h2>Discover the Beauty of  <span>Mount Feast Hotel Skardu</span></h2>
            <p class="section-subtitle">Explore Hotel Room Photos and Scenic Views</p>
            <p>
                Step into a visual journey through the Mount Feast Hotel Skardu Gallery. Nestled among the majestic peaks of Gilgit Baltistan, our hotel offers not just a stay, but an unforgettable experience. Browse our high-quality Skardu hotel pictures to see luxurious rooms, breathtaking mountain views, and serene outdoor spaces. Whether you're booking your next getaway or just exploring, this gallery brings you closer to the tranquility and elegance of our Skardu property.

            </p>
            <div class="title-border">
                <div class="title-border-inner"></div>
                <div class="title-border-inner"></div>
                <div class="title-border-inner"></div>
                <div class="title-border-inner"></div>
                <div class="title-border-inner"></div>
                <div class="title-border-inner"></div>
                <div class="title-border-inner"></div>
            </div>
        </div>

        <ul class="list-inline-listing filters filters-listing-navigation">
            <li class="active btn filtr-button mb-2 filtr" data-filter="all">All</li>
            <li data-filter="1" class="btn btn-inline mb-2 filtr-button filtr">Twin Bed </li>
            <li data-filter="2" class="btn btn-inline mb-2 filtr-button filtr">Super Deluxe </li>
        </ul>
        <br />
        <div class="row">
            <div class="filtr-container">
                <div class="col-lg-3 col-md-4 col-sm-6 col-12  filtr-item" data-category="1">
                    <div class="portfolio-item car-magnify-gallery">
                        <a href="~/Content/Assets/img/gallery/SkarduGallery/deluxe.png" title="Twin Bed">
                            <img src="~/Content/Assets/img/gallery/SkarduGallery/TwinBed.png" alt="Twin" class="img-fluid">
                        </a>
                        <div class="portfolio-content">
                            <div class="portfolio-content-inner">

                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-4 col-sm-6 col-12  filtr-item" data-category="2">
                    <div class="portfolio-item car-magnify-gallery">
                        <a href="~/Content/Assets/img/gallery/SkarduGallery/deluxe.png" title="Super Deluxe">
                            <img src="~/Content/Assets/img/gallery/SkarduGallery/deluxe.png" alt="Deluxe" class="img-fluid">
                        </a>
                        <div class="portfolio-content">
                            <div class="portfolio-content-inner">

                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-6 col-12  filtr-item" data-category="2">
                    <div class="portfolio-item car-magnify-gallery">
                        <a href="~/Content/Assets/img/gallery/SkarduGallery/deluxe.png" title="Super Deluxe">
                            <img src="~/Content/Assets/img/gallery/SkarduGallery/Deluxe2.png" alt="Deluxe" class="img-fluid">
                        </a>
                        <div class="portfolio-content">
                            <div class="portfolio-content-inner">

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
