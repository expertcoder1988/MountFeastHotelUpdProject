<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var form = document.getElementById('myForm');
        var submitButton = document.getElementById('submitButton');
        var loaderSpinner = document.getElementById('loaderSpinner');
        var buttonText = document.getElementById('buttonText');

        if (form && submitButton && loaderSpinner && buttonText) {
            form.addEventListener('submit', function () {
                // Disable the button to prevent multiple submissions
                submitButton.disabled = true;

                // Show the loader spinner and move it to the left side
                loaderSpinner.style.display = 'inline-block';
                buttonText.style.display = 'inline'; // Keep "Book Now" text visible

                // Apply styles to position the spinner to the left
                loaderSpinner.classList.add('me-2');
                buttonText.classList.add('ms-2');

            });
        }
    });
</script>


<script>
    $(function () {
        $('.payment-card.selectable').click(function () {
            $('.payment-card.selectable').removeClass('selected');
            $('.checkmark').addClass('d-none');
            $(this).addClass('selected');
            $(this).find('.checkmark').removeClass('d-none');
        });
    });
</script>
<script>
    function setPaymentType(element, value) {
        // Set hidden input value
        document.getElementById("PaymentType").value = value;

        // Remove selection from all cards
        document.querySelectorAll(".payment-card").forEach(card => {
            card.classList.remove("selected");
            card.querySelector(".checkmark").classList.add("d-none");
        });

        // Add selection to clicked card
        element.classList.add("selected");
        element.querySelector(".checkmark").classList.remove("d-none");
    }
</script>

<script>
    document.getElementById("onlinePaymentBtn").addEventListener("click", function () {
        document.getElementById("PaymentType").value = "purchase"; // Set payment type
        document.getElementById("bookingForm").submit(); // Submit the form
    });

    document.getElementById("directBookingBtn").addEventListener("click", function () {
        document.getElementById("PaymentType").value = "refinance"; // Set payment type
        document.getElementById("bookingForm").submit(); // Submit the form
    });
</script>

<script>
    var isVoucherApplied = false;

    function applyVoucher() {
        if (isVoucherApplied) {
            alert('Voucher has already been applied.');
            return;
        }

        var voucherCode = document.getElementById('voucherCode').value;
        var totalAmountField = document.getElementById('totalPriceCell');
        var hiddenVoucherCodeField = document.getElementById('hiddenVoucherCode');

        if (!totalAmountField || !hiddenVoucherCodeField) {
            console.error('Total Amount or Hidden Voucher Code field is not found');
            return;
        }

        $.ajax({
            url: '/SearchResult/GetDiscountAmount',
            type: 'POST',
            data: { code: voucherCode },
            success: function (response) {
                if (response.success) {
                    var totalAmount = parseFloat(totalAmountField.innerText.replace('Rs. ', '').replace(',', ''));
                    var discountAmount = response.discountAmount;
                    var newTotalAmount = totalAmount - discountAmount;

                    totalAmountField.innerText = newTotalAmount;

                    isVoucherApplied = true;
                    hiddenVoucherCodeField.value = voucherCode;
                    document.getElementById('voucherIcon').innerHTML = '<i class="fa fa-check" style="color: red;"></i>';
                    const applyBtn = document.getElementById('applyVoucherBtn');
                    applyBtn.disabled = true;
                    applyBtn.innerHTML = '<span id="voucherIcon" style="margin-right: 8px;"><i class="fa fa-check" style="color: red;"></i></span>Applied';

                    document.getElementById('removeVoucherBtn').disabled = false;

                    // Store the discount amount for restoration later
                    document.getElementById('removeVoucherBtn').setAttribute('data-discount', discountAmount);
                    document.getElementById('removeVoucherBtn').setAttribute('data-original-amount', totalAmount);
                } else {
                    alert('Invalid voucher code');
                }
            },
            error: function () {
                alert('An error occurred while applying the voucher code.');
            }
        });
    }

    function removeVoucher() {
        var totalAmountField = document.getElementById('totalPriceCell');
        var hiddenVoucherCodeField = document.getElementById('hiddenVoucherCode');

        if (!totalAmountField || !hiddenVoucherCodeField) {
            console.error('Total Amount or Hidden Voucher Code field is not found');
            return;
        }

        var originalAmount = document.getElementById('removeVoucherBtn').getAttribute('data-original-amount');

        totalAmountField.innerText = originalAmount;
        hiddenVoucherCodeField.value = '';
        isVoucherApplied = false;

        document.getElementById('voucherIcon').innerHTML = '';
        document.getElementById('applyVoucherBtn').disabled = false;
        document.getElementById('removeVoucherBtn').disabled = true;
        const applyBtn = document.getElementById('applyVoucherBtn');
        applyBtn.innerHTML = '<span id="voucherIcon" style="margin-right: 8px;"></span>Apply';

    }

</script>