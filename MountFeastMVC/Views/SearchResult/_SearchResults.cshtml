<script>
function loadSearchResults() {
    var checkIn = $('#CheckIn').val();
    var checkOut = $('#CheckOut').val();
    var adults = $('#Adults').val();
    var propertyId = $('#PropertyId').val();
    var children = $('#Children').val();
    var noOfRooms = $('#NoOfRooms').val();

    $.ajax({
        url: '@Url.Action("SearchFilterResults", "SearchResult")',
        type: 'GET',
        data: {
        CheckIn: checkIn,
        CheckOut: checkOut,
        Adults: adults,
        PropertyId: propertyId,
        Children: children,
        NoOfRooms: noOfRooms
        },
        success: function (result) {
        $('#search-results-container').html(result); // Inject the partial view with full design
        },
        error: function (error) {
        console.log("Error loading search results:", error);
        }
        });
        }
</script>