<script type="text/javascript">
    var $j = jQuery.noConflict();
    var value = 0;
    var DiscountedAmount = 0

    $j(function () {

        $j("input[name='RemoveRooms']").hide();

        $j("input[name='CalculateMinus']").on('click', function (e) {
    var id = ($j(this).data("value"));
    if ($j('#txtQuatntity_' + id).val() > 1) {
        value = parseInt($j('#txtQuatntity_' + id).val()) - 1;
        $j('#txtQuatntity_' + id).val(value);

        // Update only the price and preserve the "/ @NoOfDays Nights"
        totalAmount = parseInt($j('#hdNormalPrice_' + id).val() * value);
        var noOfNights = $j("#spNormalPrice_" + id).html().split('/')[1]; // Extract the Nights part
        $("#spNormalPrice_" + id).html('Rs. ' + totalAmount + ' / ' + noOfNights);

        DiscountedAmount = parseInt($j('#hdDiscountedPrice_' + id).val() * value);
        var discountedNoOfNights = $j("#spDiscountedPRice_" + id).html().split('/')[1];
        $("#spDiscountedPRice_" + id).html('Rs. ' + DiscountedAmount + ' / ' + discountedNoOfNights);
    }

    Calculate(id);
});

        $j("input[name='CalculatePlus']").on('click', function (e) {
    var id = ($j(this).data("value"));
    var _NoOfRoomsLeft = $j('#NoOfRoomsLeft_' + id).val();
    if ($j('#txtQuatntity_' + id).val() < parseInt(_NoOfRoomsLeft)) {
        value = parseInt($j('#txtQuatntity_' + id).val()) + 1;
        $j('#txtQuatntity_' + id).val(value);

        // Update only the price and preserve the "/ @NoOfDays Nights"
        totalAmount = parseInt($j('#hdNormalPrice_' + id).val() * value);
        var noOfNights = $j("#spNormalPrice_" + id).html().split('/')[1];
        $("#spNormalPrice_" + id).html('Rs. ' + totalAmount + ' / ' + noOfNights);

        DiscountedAmount = parseInt($j('#hdDiscountedPrice_' + id).val() * value);
        var discountedNoOfNights = $j("#spDiscountedPRice_" + id).html().split('/')[1];
        $("#spDiscountedPRice_" + id).html('Rs. ' + DiscountedAmount + ' / ' + discountedNoOfNights);
    }

    Calculate(id);
        });

        $j("input[name='CalculateMobMinus']").on('click', function (e) {
    var id = $j(this).data("value");
    var quantityInput = $j('#txtMobQuatntity_' + id);
    var currentQuantity = parseInt(quantityInput.val());

    if (currentQuantity > 1) {
        var newQuantity = currentQuantity - 1;
        quantityInput.val(newQuantity);

        // Update the prices based on the new quantity
        var normalPricePerUnit = parseInt($j('#hdNormalMobPrice_' + id).val());
        var discountedPricePerUnit = parseInt($j('#hdDiscountedMobPrice_' + id).val());

        var totalAmount = normalPricePerUnit * newQuantity;
        var discountedAmount = discountedPricePerUnit * newQuantity;

        // Extract the "/ @NoOfDays Nights" part
        var noOfNights = $j("#spNormalMobPrice_" + id).html().split('/')[1];

        // Update the displayed prices
        $("#spNormalMobPrice_" + id).html('Rs. ' + totalAmount + ' / ' + noOfNights);
        $("#spDiscountedMobPRice_" + id).html('Rs. ' + discountedAmount + ' / ' + noOfNights);
    }

    Calculate(id);
});

        $j("input[name='CalculateMobPlus']").on('click', function (e) {
    var id = $j(this).data("value");
    var quantityInput = $j('#txtMobQuatntity_' + id);
    var currentQuantity = parseInt(quantityInput.val());
    var maxQuantity = parseInt($j('#NoOfRoomsLeft_' + id).val());

    if (currentQuantity < maxQuantity) {
        var newQuantity = currentQuantity + 1;
        quantityInput.val(newQuantity);

        // Update the prices based on the new quantity
        var normalPricePerUnit = parseInt($j('#hdNormalMobPrice_' + id).val());
        var discountedPricePerUnit = parseInt($j('#hdDiscountedMobPrice_' + id).val());

        var totalAmount = normalPricePerUnit * newQuantity;
        var discountedAmount = discountedPricePerUnit * newQuantity;

        // Extract the "/ @NoOfDays Nights" part
        var noOfNights = $j("#spNormalMobPrice_" + id).html().split('/')[1];

        // Update the displayed prices
        $("#spNormalMobPrice_" + id).html('Rs. ' + totalAmount + ' / ' + noOfNights);
        $("#spDiscountedMobPRice_" + id).html('Rs. ' + discountedAmount + ' / ' + noOfNights);
    }

    Calculate(id);
});



        $j("input[name='ShowDetails']").click(function () {
            var _id = $j(this).attr('id');
            _id = _id.split('_');
            _id = _id[1];

            $j("#SelectRoom_" + _id).prop("checked", true);
            // $j("#RemoveRooms_" + _id).show();
            Calculate(_id);
        });

        $j("input[name='RemoveRooms']").click(function () {
            var _id = $j(this).attr('id');
            _id = _id.split('_');
            _id = _id[1];

            $j("#SelectRoom_" + _id).prop("checked", false);

            Calculate(_id);
            $j("#RemoveRooms_" + _id).hide();
        });

        function Calculate(_Id) {
            var TotalRooms = 0;
            var GrandTotal = 0;
            var RoomCate = "";
            var _RoomCateRoomNums = '';
            var _RatePlanID = '';
            var _RoomRates = '';
            var _RoomRatesN = '';
            var flag = 0;
            var isMobile = $j(window).width() <= 768; // Check if it's a mobile screen

            // Room category
            var _roomCate = $j('#hdRoomCate_' + _Id).val();
            var roomCateRoomNums = $j('#txtQuatntity_' + _Id).val();

            // Set RoomRates and RatePlanID for mobile or PC
            if (isMobile) {
                _RoomRates = _RoomRates + ',' + $j('#hdDiscountedMobPrice_' + _Id).val();
                _RoomRatesN = _RoomRatesN + ',' + $j('#hdNormalMobPrice_' + _Id).val();
            } else {
                _RoomRates = _RoomRates + ',' + $j('#hdDiscountedPrice_' + _Id).val();
                _RoomRatesN = _RoomRatesN + ',' + $j('#hdNormalPrice_' + _Id).val();
            }

            // Extract RatePlanID
            var _ratePlanID = $j('#RatePlanID_' + _Id).attr('id');
            _ratePlanID = _ratePlanID.split('_');
            _ratePlanID = _ratePlanID[1];
            _RatePlanID = _RatePlanID + "," + _ratePlanID;

            // Calculate TotalRooms and GrandTotal for mobile or PC
            TotalRooms = TotalRooms + parseInt($j("#txtQuatntity_" + _Id).val());

            if (isMobile) {
                // GrandTotal calculation for mobile version
                GrandTotal = GrandTotal + parseInt($j("#spDiscountedMobPRice_" + _Id).html().split(' ')[1]);
                if (isNaN(GrandTotal) || GrandTotal == 0) {
                    GrandTotal = parseInt($j('#hdNormalMobPrice_' + _Id).val()) * TotalRooms;
                }
            } else {
                // GrandTotal calculation for PC version
                GrandTotal = GrandTotal + parseInt($j("#spDiscountedPRice_" + _Id).html().split(' ')[1]);
                if (isNaN(GrandTotal) || GrandTotal == 0) {
                    GrandTotal = parseInt($j('#hdNormalPrice_' + _Id).val()) * TotalRooms;
                }
            }

            // Update values
            RoomCate = RoomCate + "," + _roomCate;
            _RoomCateRoomNums = _RoomCateRoomNums + "," + roomCateRoomNums;

            // Set hidden fields for submission
            $j('#RatePlanIDs').val(_RatePlanID);
            $j('#hdTotalRooms').val(TotalRooms);
            $j('#hdTotalAmount').val(GrandTotal);
            $j('#_TotalRooms').html(TotalRooms);
            $j('#_TotalAmount').html(GrandTotal);
            $j('#_TotalRooms1').html(TotalRooms);
            $j('#_TotalAmount1').html(GrandTotal);
            $j('#RoomCatCode').val(RoomCate);
            $j('#RoomCateRoomNums').val(_RoomCateRoomNums);
            $j('#RoomRates').val(_RoomRates);

            flag = 1;

            // Show an alert if no rooms are selected
            if (GrandTotal == 0) {
                alert("Please select at least one room.");
            }
        }



