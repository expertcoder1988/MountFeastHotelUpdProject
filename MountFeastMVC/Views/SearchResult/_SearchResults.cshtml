        $j("#dvPolicy a").click(function () {

            var _id = $j(this).attr('id');
            _id = _id.split('_');
            _id = _id[1];

            try {
                $.ajax({
                    url: '/SearchResult/RoomPolicy',
                    type: 'GET',
                    dataType: 'json',
                    contentType: 'application/json',
                    data: '&CancellationPolicy=' + _id,
                    success: function (data) {
                        $("#policyName").empty();
                        $("#Breakfst").empty();
                        $("#CancellationPolicy").empty();
                        $("#FreeCancelBefore").empty();
                        $("#GuestChargedForCancellation").empty();
                        $("#ChargedForNoShow").empty();
                        // alert(_id)
                        // console.log(data);
                        if (data.length > 0) {
                            $.each(data, function (i, item) {
                                if (i == 0) {
                                    $("#policyName").append(item.RatePlanName);

                                    if (item.Breakfst == 1) {
                                        $("#Breakfst").append("Included");
                                    }
                                    else {
                                        $("#Breakfst").append("Not Included");
                                    }

                                    $("#CancellationPolicy").append(item.CancellationPolicy);

                                    if (item.ChargedForNoShow == 1) {
                                        $("#ChargedForNoShow").append("Same as the cancellation fee");
                                    }
                                    else {
                                        $("#ChargedForNoShow").append("100% of the total price");
                                    }

                                    if (item.FreeCancelBefore == 1) {
                                        $("#FreeCancelBefore").append("The cost of the first night");
                                    }
                                    else if (item.FreeCancelBefore == 2) {
                                        $("#FreeCancelBefore").append("50% of the total price");
                                    }
                                    else {
                                        $("#FreeCancelBefore").append("100% of the total price");
                                    }


                                    if (item.HowlongFreeOfCharge == 1) {
                                        $("#GuestChargedForCancellation").append("until 6:00PM on the day of arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 2) {
                                        $("#GuestChargedForCancellation").append("until 2:00PM on the day of arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 3) {
                                        $("#GuestChargedForCancellation").append("until 1 day before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 4) {
                                        $("#GuestChargedForCancellation").append("until 2 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 5) {
                                        $("#GuestChargedForCancellation").append("until 3 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 6) {
                                        $("#GuestChargedForCancellation").append("until 5 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 7) {
                                        $("#GuestChargedForCancellation").append("until 7 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 8) {
                                        $("#GuestChargedForCancellation").append("until 14 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 9) {
                                        $("#GuestChargedForCancellation").append("until 21 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 10) {
                                        $("#GuestChargedForCancellation").append("until 28 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 11) {
                                        $("#GuestChargedForCancellation").append("until 30 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 12) {
                                        $("#GuestChargedForCancellation").append("until 42 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 13) {
                                        $("#GuestChargedForCancellation").append("until 60 days before arrival");
                                    }
                                    else {
                                        $("#FreeCancelBefore").append("No Free Cancellation");
                                    }

                                    debugger
                                    $j("#policyModal").show();
                                }
                            });
                        }
                    },
                    error: function (err) {
                        alert(err.status + " : " + err.statusText);
                    }

                });
            } catch (e) {
                alert(e.status + " : " + e.statusText);
                // window.location.href = '/Booking/BookingList';
            }
        });
    });
</script>




