                                                        <input type="button" class="btn-sm btn-light  rounded-button" style="background-color: ButtonFace; box-shadow: none; border: none;" data-value="@item.Id" ID="CalculateMobPlus_@item.Id" name="CalculateMobPlus" value="+" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-sm d-none d-sm-block"
                                                 style="font-weight: bold; font-size: 18px; margin: 2px, 2px">
                                                @if (item.TotalAmount == item.discountedprice || item.discountedprice == null || item.discountedprice == 0)
                                                {

                                                    <div class="col-sm" style="font-weight: bold; font-size: 18px; margin: 2px, 2px">
                                                        Rs.

                                                        <span id="spNormalPrice_@item.Id">@item.TotalAmount</span><span> /  @NoOfDays Nights</span>

                                                    </div> }
                                                else
                                                {
                                                    <div class="col-sm" style="font-weight: bold; font-size: 18px; margin: 2px, 2px">
                                                        <span id="spNormalPrice_@item.Id" style="text-decoration:line-through">  Rs. @item.TotalAmount /  @NoOfDays Nights</span><br />
                                                        <span id="spDiscountedPRice_@item.Id" style="color:red">  Rs. @item.discountedprice /  @NoOfDays Nights</span>
                                                    </div>}

                                                <input type="hidden" id="hdNormalPrice_@item.Id" value="@item.TotalAmount" />
                                                <input type="hidden" id="hdDiscountedPrice_@item.Id" value="@item.discountedprice" />
                                                <input type="hidden" name="RatePlanID" id="RatePlanID_@item.Id" value="@item.rateplanId" />
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Facilities List -->
                                    <ul class="facilities-list clearfix">

                                        <li style="font-size:10px">
                                            <i class="fa fa-check"></i>
                                            <span>PARKING INCLUDED</span>

                                        </li>
                                        <li style="font-size:10px">
                                            <i class="fa fa-check"></i>
                                            <span>ROOM SERVICE</span>

                                        </li>
                                        <li style="font-size:10px">
                                            <i class="fa fa-check"></i>
                                            <span>TV</span>

                                        </li>

                                        <li style="font-size:10px">
                                            <i class="fa fa-check"></i>
                                            <span>RECEPTION 24 HOUR</span>

                                        </li>
                                        <li style="font-size:10px">
                                            <i class="fa fa-check"></i>
                                            <span>WIFI</span>

                                        </li>

                                    </ul>
                                </div>
                                <div class="property-footer row">
                                    <span class="left col-8">
                                        <a href="#"><i class="fa fa-user"><span> @item.AdultAllowed Adult</span> <span>, @item.NoOfChildAllowed Children</span></i></a>
                                    </span>
                                    <span class="right col-4">
                                        <input type="submit" class="btn btn-danger booking" data-value="@item.Id" style="color: white; background-color: #bb2d3b; text-align: center " name="ShowDetails" id="ShowDetails_@item.Id" value="Reserve This" />
                                        <input type="button" class="btn btn-danger booking" data-value="@item.Id" style="display:none" name="RemoveRooms" id="RemoveRooms_@item.Id" value="Remove This" />
                                    </span>
                                </div>
                            </div>
                        </div>
                        <input type="hidden" id="hdTotalRooms" name="hdTotalRooms" value="1" />
                        <input type="hidden" id="hdTotalAmount" name="hdTotalAmount" value="@item.TotalAmount" />
                        <input type="hidden" name="CheckIn" value="@_CheckIn" />
                        <input type="hidden" name="CheckOut" value="@_CheckOut" />
                        <input type="hidden" name="RoomCatCode" id="RoomCatCode" />
                        <input type="hidden" name="Adults" value="@_adults" />
                        <input type="hidden" name="Children" value="@_children" />
                        <input type="hidden" name="NoOfRooms" value="@_NoOfRooms" />
                        <input type="hidden" name="RoomRate" value="@roomPrice" />
                        <input type="hidden" name="RoomCate" value="@item.RoomCateCode" />
                        <input type="hidden" name="RoomCateRoomNums" id="RoomCateRoomNums" />
                        <input type="hidden" name="RatePlanIDs" value="@item.rateplanId" />
                        <input type="hidden" name="RoomRates" value="@item.discountedprice" />}
                    @*<input type="hidden" id="hdNormalMobPrice_@item.Id" value="@item.TotalAmount" />
                        <input type="hidden" id="hdDiscountedMobPrice_@item.Id" value="@item.discountedprice" />*@

                }
            }
        }


    </div>
</div>
