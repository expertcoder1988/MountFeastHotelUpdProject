    <script>
        // Set default dates to today and tomorrow
        document.addEventListener('DOMContentLoaded', function () {
            const today = new Date();
            const tomorrow = new Date();
            tomorrow.setDate(today.getDate() + 1);

            // Format dates
            const options = { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' };
            document.getElementById('ci_date_text').textContent = today.toLocaleDateString('en-US', options);
            document.getElementById('co_date_text').textContent = tomorrow.toLocaleDateString('en-US', options);

            // Set hidden input values
            document.querySelector('input[name="checkin_monthday"]').value = today.getDate();
            document.querySelector('input[name="checkin_year_month"]').value = `${today.getFullYear()}-${today.getMonth() + 1}`;
            document.querySelector('input[name="checkout_monthday"]').value = tomorrow.getDate();
            document.querySelector('input[name="checkout_year_month"]').value = `${tomorrow.getFullYear()}-${tomorrow.getMonth() + 1}`;

            // Add click handlers to date cells (this will need to match your calendar's structure)
            setTimeout(() => {
                setupCalendarCloseBehavior();
            }, 500); // Small delay to ensure calendar is loaded
        });

        function setupCalendarCloseBehavior() {
            // Find all date cells in the calendar
            const dateCells = document.querySelectorAll('.bui-calendar__date');

            dateCells.forEach(cell => {
                cell.addEventListener('click', function () {
                    // Wait a small moment for the dates to update
                    setTimeout(() => {
                        checkIfShouldCloseCalendar();
                    }, 100);
                });
            });
        }

        function checkIfShouldCloseCalendar() {
            const checkinSelected = document.getElementById('ci_date_text').textContent.trim() !== '';
            const checkoutSelected = document.getElementById('co_date_text').textContent.trim() !== '';

            if (checkinSelected && checkoutSelected) {
                closeCalendar();
            }
        }

        function closeCalendar() {
            // Try multiple ways to close the calendar since we don't know the exact implementation

            // 1. Check if there's a close button and click it
            const closeButton = document.querySelector('.bui-calendar__close, [data-calendar-close]');
            if (closeButton) {
                closeButton.click();
                return;
            }

            // 2. Check for overlay click handler
            const overlay = document.querySelector('.bui-calendar-overlay, .searchbox_cross_product__section-container');
            if (overlay) {
                overlay.click();
                return;
            }

            // 3. Hide the calendar directly
            const calendar = document.querySelector('.searchbox-calendar-bui');
            if (calendar) {
                calendar.style.display = 'none';
                calendar.classList.remove('open', 'active');
            }

            // 4. Remove the 'open' attribute if it exists
            const calendarContainer = document.querySelector('[data-calendar]');
            if (calendarContainer) {
                calendarContainer.removeAttribute('open');
            }

            console.log('Calendar closed');
        }

        // Alternative approach if the above doesn't work - mutation observer
        function setupMutationObserver() {
            const observer = new MutationObserver(function (mutations) {
                mutations.forEach(function (mutation) {
                    if (mutation.type === 'attributes' &&
                        (mutation.attributeName === 'data-checkin-text' ||
                            mutation.attributeName === 'data-checkout-text')) {
                        checkIfShouldCloseCalendar();
                    }
                });
            });

            const config = { attributes: true, attributeFilter: ['data-checkin-text', 'data-checkout-text'] };
            const checkinElement = document.getElementById('ci_date_text');
            const checkoutElement = document.getElementById('co_date_text');

            if (checkinElement) observer.observe(checkinElement, config);
            if (checkoutElement) observer.observe(checkoutElement, config);
        }

        // Call this in DOMContentLoaded if the click approach doesn't work
        // setupMutationObserver();
    </script>
