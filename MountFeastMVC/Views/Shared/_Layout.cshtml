    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const navLinks = document.querySelectorAll(".nav-link");
            const menuItems = document.querySelectorAll(".menu-item");

            // Get default active category (first one with 'active' class)
            const activeCategory = document.querySelector(".nav-link.active").getAttribute("data-category");

            // Hide all menu items except the active category
            menuItems.forEach(item => {
                if (item.getAttribute("data-category") !== activeCategory) {
                    item.style.display = "none";
                }
            });

            navLinks.forEach(link => {
                link.addEventListener("click", function () {
                    // Remove active class from all links
                    navLinks.forEach(nav => nav.classList.remove("active"));
                    this.classList.add("active");

                    // Get clicked category
                    const category = this.getAttribute("data-category");

                    // Show/hide menu items
                    menuItems.forEach(item => {
                        if (item.getAttribute("data-category") === category) {
                            item.style.display = "flex";
                        } else {
                            item.style.display = "none";
                        }
                    });
                });
            });
        });

    </script>
    <script>
        $(document).ready(function () {
            function updateBackgroundAndText() {
                var $carouselItems = $('.slick .item');
                var minDiff = Infinity;
                var $centerItem = null;
                var carouselCenter = $('.slick').offset().left + ($('.slick').width() / 2);

                $carouselItems.each(function () {
                    var itemCenter = $(this).offset().left + ($(this).width() / 2);
                    var diff = Math.abs(carouselCenter - itemCenter);

                    if (diff < minDiff) {
                        minDiff = diff;
                        $centerItem = $(this);
                    }
                });

                if ($centerItem) {
                    var title = $centerItem.data('title');
                    var description = $centerItem.data('description');
                    var bgImage = $centerItem.data('bg');

                    $('#dynamic-title').text(title);
                    $('#dynamic-description').text(description);
                    $('#background-container').css({
                        'background-image': 'url(' + bgImage + ')',
                        'transition': 'background-image 0.5s ease-in-out'
                    });
                }
            }

            // Run function when slide changes
            $('.slick').on('afterChange', function () {
                updateBackgroundAndText();
            });

            // Initial update on page load
            updateBackgroundAndText();
        });
    </script>
