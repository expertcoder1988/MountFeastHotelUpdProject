  document.addEventListener("DOMContentLoaded", function () {
    const filterButtons = document.querySelectorAll(".filtr-button");
    const galleryButtonContainer = document.getElementById("gallery-button-container");

    const galleryLinks = {
      "1": '@Url.Action("Naran","Location")',      // Naran
      "2": '@Url.Action("Skardu", "Location")',     // Skardu
      "3": '@Url.Action("Islamabad", "Location")'   // Islamabad
    };

    filterButtons.forEach(button => {
      button.addEventListener("click", function () {
        const filterValue = this.getAttribute("data-filter");
        if (galleryLinks[filterValue]) {
          galleryButtonContainer.innerHTML = `
            <a class="btn btn-danger" href="${galleryLinks[filterValue]}">Learn More</a>
          `;
          galleryButtonContainer.style.display = "block";
        } else {
          galleryButtonContainer.style.display = "none";
        }
      });
    });

    // Optional: hide on load if "All" is the default
    galleryButtonContainer.style.display = "none";
  });
